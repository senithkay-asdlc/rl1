{
  "name": "expense-webapp",
  "type": "web-application",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "expense-webapp",
  "entrypoint": "deployment/web-application",
  "exposure": "internet",
  "stories": [
    1,
    2,
    3,
    4,
    5,
    6,
    7,
    8
  ],
  "description": "Single-page app for all three roles: employees submit and track claims, managers review and decide on pending claims, finance reviews approved claims and downloads payroll export files. Calls expense-api for all data; holds no business logic or secrets of its own.",
  "dependencies": [
    {
      "kind": "component",
      "name": "expense-api",
      "wiring": {
        "endpoint": {
          "component": "rl1-expense-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "EXPENSE_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "thunder-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "rl1-thunder-auth",
        "envBindings": {
          "client_id": "THUNDER_AUTH_CLIENT_ID",
          "issuer": "THUNDER_AUTH_ISSUER",
          "jwks_url": "THUNDER_AUTH_JWKS_URL",
          "scopes": "THUNDER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "wireframes",
    "react-webapp",
    "astryx-design-system",
    "thunder-authentication"
  ]
}
