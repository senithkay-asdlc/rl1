{
  "version": 1,
  "coldStartRole": "Employee",
  "publicComponents": [],
  "roles": [
    {
      "name": "Employee",
      "description": "Submits expense claims and tracks their own claim status.",
      "stories": [1, 2, 3],
      "grantedBy": "first sign-in",
      "permissions": [
        { "component": "expense-api", "actions": ["create claim", "read own claims", "update own claim"] },
        { "component": "expense-webapp", "screens": ["My Claims", "New Claim", "Claim Detail"] }
      ]
    },
    {
      "name": "Manager",
      "description": "Reviews and approves or rejects claims submitted by direct reports.",
      "stories": [4, 5],
      "grantedBy": "Administrators",
      "permissions": [
        { "component": "expense-api", "actions": ["read team claims", "approve claim", "reject claim"] },
        { "component": "expense-webapp", "screens": ["Pending Approvals", "Claim Review"] }
      ]
    },
    {
      "name": "Finance",
      "description": "Reviews approved claims across the organization and exports them for payroll.",
      "stories": [6, 7, 8],
      "grantedBy": "Administrators",
      "permissions": [
        { "component": "expense-api", "actions": ["read approved claims", "create export batch"] },
        { "component": "expense-webapp", "screens": ["Approved Claims", "Export History"] }
      ]
    }
  ],
  "testUsers": [
    { "username": "test-employee", "role": "Employee" },
    { "username": "test-manager", "role": "Manager" },
    { "username": "test-finance", "role": "Finance" }
  ],
  "thunder": {
    "name": "Expense Tracker",
    "type": "browser",
    "scopes": "openid profile email group ou"
  }
}
